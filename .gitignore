# Model weights (too large for GitHub — bundled in .app instead).
# Use ``ner/**/*`` glob so checkpoints in nested kfold dirs are also caught.
ner/**/*.pt
ner/**/*.pkl
ner/**/*.ckpt
ner/**/*.safetensors
ner/joint_entity_role_model/
ner/joint_entity_role_model_kfold/
ner/provenance_model_kfold/
ner/contents_model_kfold/

# Reference + draft PDFs inside the ML workspace (not for public repo).
ner/**/*.pdf
ner/ontology/

# ML training notes + intermediate-run results (transient, regenerable).
# Keep ner/dictabert_error_analysis.json — referenced in CLAUDE.md Rule 33.
ner/HalleluBERT.txt
ner/baseline_5fold_results*.json
ner/kfold_results.json

# Compiled ontology PDFs (keep the .tex sources if any).
ontology/documentation/*.pdf

# Training-data caches (large; regenerated from source TSVs)
data/tsvs/genre_samples.tsv
data/tsvs/marc500_sentences.tsv
data/tsvs/filtered_manuscripts_after_906a.tsv

# Paper draft directory (entire dir excluded — not for public repo).
# Includes .tex sources, figures, verification scripts, literature,
# build artifacts, and all subdirectories.
paper/

# Reference PDFs (large)
docs/*.pdf

# Sensitive / external
docs/mails from experts/

# Coding-agent transient state
.codex/
.github/ai/
.claude/scheduled_tasks.lock

# Build artifacts
dist/
*.dmg

# Python bytecache
__pycache__/
*.pyc

# Logs
*.log
.coverage

# macOS
.DS_Store

# Data files (large) — NLI authority + KIMA third-party + MARC dumps
data/kima/kima_index.db
data/kima/*.tsv
data/NLI_AUTHORITY_XML/
data/marc-subset-10k.*
data/catalog-v001.xml
data/tsvs/17th_century_samples.tsv
data/tsvs/top100_richest.tsv
data/output/
data/samples/
data/pilot-sample/

# All MARC binary dumps EXCEPT the intentional test_manuscripts/ fixtures.
data/mrc/*.mrc
!data/mrc/test_manuscripts/

# Secrets / credentials — NEVER commit these
*.token
*token*.txt
*.env
.env.*
*credentials*.json
secrets/
.claude/secrets/

# Audit / revert working files (may contain QID lists or bearer-token cmd lines)
/tmp/wd_token.txt
audit_*.json.bak
revert_*.log


